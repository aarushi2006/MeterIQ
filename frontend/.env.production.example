# Production build template for the frontend.
#
# Vite inlines these at BUILD time, so they must be present in the build
# environment (GitHub Actions variable, Vercel/Netlify build settings, ...),
# not only at runtime. Never commit a real .env file.
#
# Public base URL of the Express API, including the /api prefix.
VITE_API_BASE_URL=https://meteriq-api.onrender.com/api
# Mount path of the deployed site:
#   GitHub Pages project site -> /<repository-name>/
#   Vercel / Netlify / root   -> /
VITE_BASE_PATH=/
