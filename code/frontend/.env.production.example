# Production build template for the frontend (Vercel).
#
# Vite inlines these at BUILD time. On Vercel set them under
# Project -> Settings -> Environment Variables (Production + Preview),
# and set Root Directory to `code/frontend`.
#
# Public base URL of the Express API, including the /api prefix.
VITE_API_BASE_URL=https://meteriq-api.onrender.com/api
# Vercel serves at the domain root.
VITE_BASE_PATH=/
