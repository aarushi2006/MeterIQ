# Production template for the FastAPI ML service.
# Hosted platforms inject PORT themselves; ML_PORT is the local override.
ML_HOST=0.0.0.0
ML_PORT=8000

# Comma-separated origins allowed to call the ML service directly.
# The Express API calls it server-to-server, so this only matters for direct
# browser calls (normally none).
ML_CORS_ORIGINS=https://aarushi2006.github.io

# Artifact locations. In the container image the small artifacts are baked in
# at /app/data/output. Mount a persistent volume at this path if you also need
# anomaly_observations.parquet (~1 GB).
METERIQ_OUTPUT_DIR=/app/data/output
METERIQ_CACHE_DIR=/app/data/cache

# Optional overrides (defaults resolve relative to ml-service/):
# METERIQ_DATA_DIR=/app/data/Data
# METERIQ_LOG_DIR=/app/logs
