# Production template for the Express API. Set these in the hosting platform's
# environment settings (Render/Railway/etc). Never commit a real .env.
NODE_ENV=production
PORT=5050

# MongoDB Atlas SRV connection string (database name: meteriq).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/meteriq?retryWrites=true&w=majority

# Long random secret, e.g. `openssl rand -hex 48`. Platform secrets should use
# `generateValue: true` where supported.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Base URL of the FastAPI service (no trailing slash, no /api suffix).
# Same-region internal address on Render, e.g. http://meteriq-ml:8000
ML_SERVICE_URL=http://meteriq-ml:8000
ML_SERVICE_TIMEOUT_MS=60000

# Exact browser origin(s) allowed by CORS, comma separated, no trailing slash.
FRONTEND_URL=https://aarushi2006.github.io

# Behind a platform proxy, trust exactly one hop for client IP + protocol.
TRUST_PROXY=1
