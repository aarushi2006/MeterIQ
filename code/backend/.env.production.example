
# Production template for the Express API.
# Set actual secrets in Render Environment Variables.
# Never commit a real .env file.

NODE_ENV=production
PORT=10000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/meteriq?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Internal Render ML service URL
ML_SERVICE_URL=http://meteriq-ml:8000
ML_SERVICE_TIMEOUT_MS=60000

# Frontend URL allowed by CORS
FRONTEND_URL=https://aarushi2006.github.io

# Trust one proxy hop on Render
TRUST_PROXY=1
